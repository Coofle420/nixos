{ pkgs, ... }:

{
  home.packages = [ pkgs.nerd-fonts.jetbrains-mono ];

  programs.kitty = {
    enable = true;
    settings = {
      # --- Font -------------------------------------------------------------
      font_family = "JetBrainsMono Nerd Font";
      bold_font = "auto";
      italic_font = "auto";
      bold_italic_font = "auto";
      font_size = 11.5;
      adjust_line_height = "105%";
      disable_ligatures = "never";

      # --- Window -----------------------------------------------------------
      background_opacity = 0.88;
      dynamic_background_opacity = true;
      hide_window_decorations = true;
      window_padding_width = 14;
      placement_strategy = "center";
      remember_window_size = true;
      initial_window_width = 1200;
      initial_window_height = 760;
      confirm_os_window_close = 0;
      resize_debounce_time = 0.1;
      sync_to_monitor = true;
      repaint_delay = 8;
      input_delay = 2;

      # --- Tabs -------------------------------------------------------------
      tab_bar_edge = "top";
      tab_bar_style = "powerline";
      tab_powerline_style = "slanted";
      tab_bar_min_tabs = 2;
      tab_bar_align = "left";
      tab_title_template = "{index}: {title}";
      active_tab_font_style = "bold";
      inactive_tab_font_style = "normal";

      # --- Cursor -----------------------------------------------------------
      cursor_shape = "beam";
      cursor_beam_thickness = 1.6;
      cursor_blink_interval = 0.5;
      cursor_stop_blinking_after = 15;
      cursor_trail = 3;
      cursor_trail_decay = "0.1 0.4";
      cursor_trail_start_threshold = 2;

      # --- Scrolling and scrollback -----------------------------------------
      scrollback_lines = 10000;
      scrollback_pager = "less --RAW-CONTROL-CHARS --quit-if-one-screen --no-init";
      scrollback_pager_history_size = 8;
      wheel_scroll_multiplier = 3.0;
      touch_scroll_multiplier = 2.0;

      # --- Mouse and selection ----------------------------------------------
      copy_on_select = "yes";
      strip_trailing_spaces = "smart";
      mouse_hide_wait = 2.0;
      detect_urls = true;
      url_style = "curly";

      # --- Bell and notifications -------------------------------------------
      enable_audio_bell = false;
      visual_bell_duration = 0.0;
      notify_on_cmd_finish = "invisible 10";
      update_check_interval = 0;
    };

    extraConfig = ''
      # Fixed ANSI palette. matugen's base16 colours are derived from a single
      # source hue, so a neutral wallpaper collapses them to near-grey and makes
      # ls/git output unreadable. Chrome (background, foreground, cursor,
      # selection, tab bar) still follows the wallpaper via matugen below.
      color0  #45475A
      color1  #F38BA8
      color2  #A6E3A1
      color3  #F9E2AF
      color4  #89B4FA
      color5  #F5C2E7
      color6  #94E2D5
      color7  #BAC2DE
      color8  #585B70
      color9  #F38BA8
      color10 #A6E3A1
      color11 #F9E2AF
      color12 #89B4FA
      color13 #F5C2E7
      color14 #94E2D5
      color15 #A6ADC8

      # Generated by matugen on every wallpaper change (see ./matugen.nix).
      # globinclude (not include) so a missing file before the first run is a no-op.
      globinclude colors-matugen.conf
    '';
  };

  # Config (layout + color) is owned by matugen now, see ../matugen.nix --
  # fastfetch is a one-shot CLI (not a daemon), so it just needs the file
  # to exist before it's next run, no merge/reload trick needed.
  programs.fastfetch.enable = true;

  programs.bash = {
    enable = true;
    initExtra = ''
      # Show fastfetch once per terminal. Remove this block to stop it.
      if [[ $- == *i* ]] && [[ -z ''${FASTFETCH_SHOWN:-} ]] && command -v fastfetch >/dev/null 2>&1; then
        export FASTFETCH_SHOWN=1
        fastfetch
      fi
    '';
  };
}
